---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const isFeatured = data.status === "featured";
---

<BaseLayout title={`${data.title} — Project`} description={data.tagline}>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
      <a href="/projects" class="text-sm font-medium text-accent hover:underline">
        &larr; All projects
      </a>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          {data.title}
        </h1>
        {
          !isFeatured && (
            <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
              In development
            </span>
          )
        }
      </div>
      <p class="mt-3 max-w-2xl text-lg text-text-muted">{data.tagline}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          data.github && (
            <a
              href={data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-accent"
            >
              View on GitHub
            </a>
          )
        }
        {
          data.liveDemo ? (
            <a
              href={data.liveDemo}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-border bg-paper px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink"
            >
              Live Demo
            </a>
          ) : (
            isFeatured && (
              <span class="inline-flex items-center rounded-full border border-dashed border-border px-5 py-2.5 text-sm text-text-muted">
                Not yet deployed
              </span>
            )
          )
        }
      </div>
    </div>
  </section>

  {
    !isFeatured ? (
      <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
        <div class="space-y-4 text-text-muted [&_p]:leading-relaxed">
          <Content />
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-4xl divide-y divide-border px-6">
        {data.problem && (
          <div class="py-12">
            <SectionHeading eyebrow="Business Problem" title="What problem does it solve?" />
            <p class="reveal mt-6 leading-relaxed text-text-muted">{data.problem}</p>
          </div>
        )}

        {data.objective && (
          <div class="py-12">
            <SectionHeading eyebrow="Objective" title="What was the goal?" />
            <p class="reveal mt-6 leading-relaxed text-text-muted">{data.objective}</p>
          </div>
        )}

        {data.requirements && data.requirements.length > 0 && (
          <div class="py-12">
            <SectionHeading eyebrow="Requirements" title="What it needed to do" />
            <ul class="reveal mt-6 space-y-2">
              {data.requirements.map((req) => (
                <li class="flex gap-2 text-sm leading-relaxed text-text-muted">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                  {req}
                </li>
              ))}
            </ul>
          </div>
        )}

        {data.solution && (
          <div class="py-12">
            <SectionHeading eyebrow="Solution" title="How it works" />
            <p class="reveal mt-6 leading-relaxed text-text-muted">{data.solution}</p>
          </div>
        )}

        {data.features && data.features.length > 0 && (
          <div class="py-12">
            <SectionHeading eyebrow="Key Features" title="What it does" />
            <ul class="reveal mt-6 grid gap-3 sm:grid-cols-2">
              {data.features.map((feature) => (
                <li class="flex gap-2 rounded-xl border border-border p-4 text-sm leading-relaxed text-text-muted">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        )}

        {data.tech && data.tech.length > 0 && (
          <div class="py-12">
            <SectionHeading eyebrow="Technology" title="What it's built with" />
            <div class="reveal mt-6 flex flex-wrap gap-2">
              {data.tech.map((item) => (
                <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
                  {item}
                </span>
              ))}
            </div>
          </div>
        )}

        {data.architecture && (
          <div class="py-12">
            <SectionHeading eyebrow="Architecture" title="How it's put together" />
            <p class="reveal mt-6 leading-relaxed text-text-muted">{data.architecture}</p>
          </div>
        )}

        {data.screenshots.length > 0 && (
          <div class="py-12">
            <SectionHeading eyebrow="Screenshots" title="What it looks like" />
            <div class="reveal mt-6 grid gap-4 sm:grid-cols-2">
              {data.screenshots.map((shot) => (
                <figure class="overflow-hidden rounded-xl border border-border">
                  <img src={shot.src} alt={shot.caption} class="w-full" loading="lazy" />
                  <figcaption class="border-t border-border bg-surface px-4 py-2 text-xs text-text-muted">
                    {shot.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}

        {data.results && (
          <div class="py-12">
            <SectionHeading eyebrow="Results / Business Value" title="What it achieves" />
            <p class="reveal mt-6 leading-relaxed text-text-muted">{data.results}</p>
          </div>
        )}

        {data.contribution && (
          <div class="py-12">
            <SectionHeading eyebrow="My Contribution" title="What I personally built" />
            <p class="reveal mt-6 leading-relaxed text-text-muted">{data.contribution}</p>
          </div>
        )}
      </div>
    )
  }
</BaseLayout>
