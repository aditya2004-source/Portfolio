---
interface Props {
  title: string;
  tagline: string;
  tech?: string[];
  href?: string;
  badge?: string;
}

const { title, tagline, tech = [], href, badge } = Astro.props;
const isLink = Boolean(href);
const Tag = isLink ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "reveal group flex h-full flex-col rounded-2xl border border-border bg-paper p-6 transition-colors",
    isLink && "hover:border-ink",
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-ink">{title}</h3>
    {badge && (
      <span class="shrink-0 rounded-full bg-accent-soft px-2.5 py-1 text-[11px] font-medium text-accent">
        {badge}
      </span>
    )}
  </div>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{tagline}</p>

  {tech.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {tech.slice(0, 5).map((item) => (
        <span class="rounded-md bg-surface px-2 py-1 text-[11px] font-medium text-text-muted">
          {item}
        </span>
      ))}
    </div>
  )}

  {isLink && (
    <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-accent">
      View project
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
  )}
</Tag>
