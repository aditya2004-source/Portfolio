---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
const isCentered = align === "center";
---

<div class={`reveal max-w-2xl ${isCentered ? "mx-auto text-center" : ""}`}>
  <p class="text-xs font-semibold uppercase tracking-widest text-accent">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-relaxed text-text-muted">{description}</p>}
</div>
