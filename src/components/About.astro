---
import SectionHeading from "./SectionHeading.astro";
import { about, education, certifications } from "../data/profile";
---

<section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-6 py-20 sm:py-28">
  <SectionHeading eyebrow="About" title="Who I am" />

  <div class="mt-10 grid gap-12 md:grid-cols-3">
    <div class="reveal space-y-5 md:col-span-2">
      {about.paragraphs.map((p) => <p class="leading-relaxed text-text-muted">{p}</p>)}
    </div>

    <div class="reveal space-y-6">
      <div class="rounded-2xl border border-border p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Quick facts</p>
        <dl class="mt-4 space-y-3">
          {
            about.quickFacts.map((fact) => (
              <div class="flex justify-between gap-4 text-sm">
                <dt class="text-text-muted">{fact.label}</dt>
                <dd class="font-medium text-ink">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="rounded-2xl border border-border p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Education</p>
        <p class="mt-3 text-sm font-medium text-ink">{education.degree}</p>
        <p class="mt-1 text-sm text-text-muted">{education.school}</p>
        <p class="mt-1 text-sm text-text-muted">{education.period} &middot; {education.detail}</p>
      </div>

      <div class="rounded-2xl border border-border p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">
          Certifications
        </p>
        <ul class="mt-3 space-y-2">
          {
            certifications.map((cert) => (
              <li class="text-sm">
                <span class="font-medium text-ink">{cert.name}</span>
                <span class="text-text-muted"> — {cert.issuer}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
