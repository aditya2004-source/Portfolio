---
import { site, nav } from "../data/site";
---

<header class="sticky top-0 z-50 border-b border-border bg-paper/80 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-semibold tracking-tight text-ink">
      {site.name}
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-text-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-text-muted transition-colors hover:text-ink"
      >
        GitHub
      </a>
      <a
        href={site.resumeHref}
        download
        class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-paper transition-colors hover:bg-accent"
      >
        Resume
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      class="flex h-9 w-9 items-center justify-center rounded-md text-ink md:hidden"
    >
      <svg
        id="nav-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg
        id="nav-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        class="hidden h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="nav-menu" class="hidden border-t border-border md:hidden">
    <nav class="flex flex-col gap-1 px-6 py-4">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-2 py-2.5 text-sm text-text-muted transition-colors hover:bg-surface hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md px-2 py-2.5 text-sm text-text-muted transition-colors hover:bg-surface hover:text-ink"
      >
        GitHub
      </a>
      <a
        href={site.resumeHref}
        download
        class="mt-2 rounded-full bg-ink px-4 py-2.5 text-center text-sm font-medium text-paper"
      >
        Download Resume
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    });
  });
</script>
