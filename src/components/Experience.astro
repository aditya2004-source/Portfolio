---
import SectionHeading from "./SectionHeading.astro";
import { experience } from "../data/profile";
---

<section id="experience" class="scroll-mt-20 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <SectionHeading eyebrow="Experience" title="Where I've worked" />

    <div class="mt-10 space-y-8">
      {
        experience.map((job) => (
          <div class="reveal rounded-2xl border border-border bg-paper p-6 sm:p-8">
            <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
              <h3 class="text-lg font-semibold text-ink">{job.role}</h3>
              <span class="text-sm font-medium text-accent">{job.period}</span>
            </div>
            <p class="mt-1 text-sm text-text-muted">{job.company}</p>
            <ul class="mt-4 space-y-2">
              {job.bullets.map((bullet) => (
                <li class="flex gap-2 text-sm leading-relaxed text-text-muted">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                  {bullet}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
