---
import { site, nav } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border-dark bg-ink text-text-on-dark">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <p class="font-semibold text-text-on-dark">{site.name}</p>
        <p class="mt-1 text-sm text-text-on-dark-muted">{site.title}</p>
        <p class="mt-4 text-sm leading-relaxed text-text-on-dark-muted">
          {site.tagline}
        </p>
      </div>

      <div class="flex flex-wrap gap-12">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-text-on-dark-muted">
            Navigate
          </p>
          <ul class="mt-3 space-y-2">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm text-text-on-dark-muted transition-colors hover:text-text-on-dark"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-text-on-dark-muted">
            Connect
          </p>
          <ul class="mt-3 space-y-2">
            <li>
              <a
                href={`mailto:${site.email}`}
                class="text-sm text-text-on-dark-muted transition-colors hover:text-text-on-dark"
              >
                Email
              </a>
            </li>
            <li>
              <a
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-text-on-dark-muted transition-colors hover:text-text-on-dark"
              >
                LinkedIn
              </a>
            </li>
            <li>
              <a
                href={site.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-text-on-dark-muted transition-colors hover:text-text-on-dark"
              >
                GitHub
              </a>
            </li>
            <li>
              <a
                href={site.resumeHref}
                download
                class="text-sm text-text-on-dark-muted transition-colors hover:text-text-on-dark"
              >
                Resume
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-border-dark pt-6 text-xs text-text-on-dark-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>{site.location}</p>
    </div>
  </div>
</footer>
